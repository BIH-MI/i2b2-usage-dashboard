# settings for the dashboard with an existing i2b2 database (docker-compose.yml only)
# copy to .env and fill in

# suffix for the container names, e.g. fastapi-backend-01
INSTANCE_NUM=01

# i2b2 Postgres database, the host must be reachable from inside the backend container
DB_HOST=your-i2b2-db-host
PORT_DB=5432
DB_NAME=your-i2b2-db-name
DB_USER=your-db-user
I2B2_PG_PASS=change-me

# i2b2 schemas the dashboard reads, the data (CRC) schema can be different per dataset
I2B2_DATA_SCHEMA=i2b2demodata
I2B2_PM_SCHEMA=i2b2pm

# URL path the dashboard is served under behind a proxy, e.g. /usage/, keep / when it runs at the root
VITE_BASE_PATH=/

# optional: integration tests (backend/tests/integration), see README
# INTEGRATION_DB_HOST=localhost
# INTEGRATION_DB_PORT=5432
# INTEGRATION_DB_USER=your-db-user
# INTEGRATION_DB_NAME=your-i2b2-db-name
